urllib3>=2.0.0

# setuptools is not a declared dependency of anything in this graph — it
# arrives in CI from the runner image, and `pip-audit` audits the INSTALLED
# environment. Unbounded, Python 3.11's runner supplied 79.0.1, which carries
# PYSEC-2026-3447 (fixed in 83.0.0). Pinning it *here* is what bounds the
# audited environment: `Tests & Lint` installs requirements-lock.txt, not
# requirements-dev.txt, so the floor added to requirements-dev.txt in #93
# never reached CI at all.
setuptools>=83.0.0
